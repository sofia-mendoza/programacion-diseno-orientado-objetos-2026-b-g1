                "componentes",
                "MEC-001"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Engranaje recto de 20 dientes\",\n  \"cantidad\": 20,\n  \"ubicacion\": \"Estante A1\",\n  \"detalle\": \"acero\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cambia nombre, cantidad, ubicación y dato propio. El código y la categoría no cambian."
          }
        },
