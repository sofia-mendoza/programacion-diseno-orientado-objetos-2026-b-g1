            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoria\": \"ROBOTICA\",\n  \"nombre\": \"Sensor de color TCS3200\",\n  \"cantidad\": 6,\n  \"ubicacion\": \"Estante D3\",\n  \"detalle\": \"Arduino\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "No se envía el código: el sistema lo genera (ROB-008, por ejemplo). Categorías: MECANICA_POTENCIA, ELECTRONICA_INSTRUMENTACION, AUTOMATIZACION_CONTROL, ROBOTICA, PROTOTIPADO_MANUFACTURA."
          }
        },
        {
          "name": "7. Actualizar componente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
